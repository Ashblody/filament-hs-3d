{
  "name": "filament-hs-3d",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:web": "tsc && vite build",
    "build:native": "CAP_BUILD=1 tsc && CAP_BUILD=1 vite build",
    "cap:sync": "npm run build:native && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "gh-pages": "^6.3.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "description": "Filament / HS 3D \u2014 zaloga, NFC/QR, kalkulator tiska"
}
